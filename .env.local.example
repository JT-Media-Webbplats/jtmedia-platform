# Supabase — copy this file to .env.local and fill in your project values
# Find these in: Supabase Dashboard → Project Settings → API

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Server-only. Needed for creating customer logins from /admin and for scripts.
# Never expose this in the browser (no NEXT_PUBLIC_ prefix).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Optional: public site URL (used in links shown to admins)
NEXT_PUBLIC_SITE_URL=https://jtmedia.se
